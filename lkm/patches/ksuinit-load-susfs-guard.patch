+/// Loads a module shipped in the ramdisk with an empty parameter string, and
+/// does nothing when the file is absent.
+fn load_optional_module(path: &str) -> Result<()> {
+    if access(path, Access::EXISTS).is_err() {
+        return Ok(());
+    }
+    anyhow::ensure!(rustix::process::getpid().is_init(), "Invalid process");
+    let buffer = std::fs::read(path).with_context(|| format!("Cannot read file {path}"))?;
+    log::info!("Loading {path}..");
+    ksuinit::load_module(&buffer, cstr!(""))
+}
